[sub_resource type="GDScript" id="GDScript_pqm7f"]
resource_name = "discussion_floor"
script/source = "extends Node2D

@export var ws:WorldState
@export var max_npc_count: int = 20


func _ready() -> void:
	var available_npc: = ws.characters.duplicate()
	for n in range(min(ws.characters.size(),max_npc_count)):
		var npc := NPC.create_npc()
		var character:Character = available_npc.pick_random()
		available_npc.erase(character)
		npc.character = character
		npc.position = Vector2(randf_range(-250,250),randf_range(-250,250))
		add_child(npc)
		
func _input(event: InputEvent) -> void:
	if event.is_action_pressed(\"ui_menu\"):
		print(\"Pausing\")
		get_tree().paused = !get_tree().paused
"


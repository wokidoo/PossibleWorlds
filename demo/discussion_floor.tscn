[gd_scene load_steps=8 format=3 uid="uid://dndl4u3cnfvbp"]

[sub_resource type="GDScript" id="GDScript_pqm7f"]
resource_name = "discussion_floor"
script/source = "extends Node2D

@export var ws:WorldState
@export var max_npc_count: int = 20
@onready var details_panel: PanelContainer = %DetailsPanel


func _ready() -> void:
	var available_npc: = ws.characters.duplicate()
	for n in range(min(ws.characters.size(),max_npc_count)):
		var npc := NPC.create_npc()
		var character:Character = available_npc.pick_random()
		available_npc.erase(character)
		npc.character = character
		npc.position = Vector2(randf_range(-250,250),randf_range(-250,250))
		add_child(npc)
		npc.hovered_over.connect(details_panel._show_character_details)
		npc.not_hovered_over.connect(details_panel._hide_character_details)
		npc.clicked_on.connect(details_panel._on_character_clicked_on)

func _input(event: InputEvent) -> void:
	if event.is_action_pressed(\"ui_menu\"):
		print(\"Pausing\")
		get_tree().paused = !get_tree().paused

func _unhandled_input(event: InputEvent) -> void:
	if details_panel.is_selected and event is InputEventMouseButton and event.button_index == MouseButton.MOUSE_BUTTON_LEFT and event.is_pressed():
		details_panel.hide()
"

[sub_resource type="Resource" id="Resource_phnct"]
metadata/__load_path__ = "res://middle_earth.tres"

[sub_resource type="GDScript" id="GDScript_a7lfq"]
resource_name = "details_panel"
script/source = "extends PanelContainer
@export var character:Character:
	set(value):
		if character != null and character.changed.is_connected(_on_character_changed):
			character.changed.disconnect(_on_character_changed)
		character = value
		if character != null:
			character.changed.connect(_on_character_changed)

var is_selected:bool = false

var info_box:VBoxContainer
var name_label:Label

var perceived_tree: PropositionTree
var ideal_tree:PropositionTree

func _ready() -> void:
	perceived_tree = PropositionTree.new()
	ideal_tree = PropositionTree.new()
	
	info_box = VBoxContainer.new()
	info_box.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	info_box.size_flags_vertical = Control.SIZE_EXPAND_FILL
	name_label = Label.new()
	var p_w_label:= Label.new()
	var i_w_label:= Label.new()
	p_w_label.text = \"Perceived World\"
	i_w_label.text = \"Ideal World\"

	perceived_tree.size_flags_vertical = Control.SIZE_EXPAND_FILL
	ideal_tree.size_flags_vertical = Control.SIZE_EXPAND_FILL
	info_box.add_child(name_label)
	info_box.add_child(HSeparator.new())
	info_box.add_child(p_w_label)
	info_box.add_child(perceived_tree)
	info_box.add_child(HSeparator.new())
	info_box.add_child(i_w_label)
	info_box.add_child(ideal_tree)
	info_box.add_child(HSeparator.new())
	add_child(info_box)
	
func update_gui():
	if character == null:
			return
	name_label.text = \"%s | Internal Tension : (%.2f)\" % [character.name,character.total_internal_tension()]
	perceived_tree.world = character.perceivedWorld
	ideal_tree.world = character.idealWorld

func _show_character_details(c:Character):
	if is_selected:
		return
	character = c
	update_gui()
	visible = true

func _hide_character_details(c:Character):
	if is_selected:
		return
	character = null
	update_gui()
	visible = false

func _on_character_changed():
	name_label.text = \"%s | Internal Tension : (%.2f)\" % [character.name,character.total_internal_tension()]


func _on_character_clicked_on(c:Character):
	character = c
	is_selected = true
	update_gui()
	self.grab_focus()
	visible = true
"


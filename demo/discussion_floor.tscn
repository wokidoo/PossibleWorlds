[sub_resource type="GDScript" id="GDScript_pqm7f"]
resource_name = "discussion_floor"
script/source = "extends Node2D

@export var ws:WorldState
@export var max_npc_count: int = 20
@onready var details_panel: VBoxContainer = %DetailsPanel


func _ready() -> void:
	var available_npc: = ws.characters.duplicate()
	for n in range(min(ws.characters.size(),max_npc_count)):
		var npc := NPC.create_npc()
		var character:Character = available_npc.pick_random()
		available_npc.erase(character)
		npc.character = character
		npc.position = Vector2(randf_range(-250,250),randf_range(-250,250))
		add_child(npc)
		npc.hovered_over.connect(details_panel._show_character_details)
		npc.not_hovered_over.connect(details_panel._hide_character_details)
		
func _input(event: InputEvent) -> void:
	if event.is_action_pressed(\"ui_menu\"):
		print(\"Pausing\")
		get_tree().paused = !get_tree().paused
"

[sub_resource type="GDScript" id="GDScript_a7lfq"]
resource_name = "details_panel"
script/source = "extends VBoxContainer
@export var character:Character:
	set(value):
		character = value

var info_box:VBoxContainer
var name_label:Label
var panel_container: PanelContainer
var p_container: VBoxContainer
var i_container: VBoxContainer

func _ready() -> void:
	panel_container = PanelContainer.new()
	info_box = VBoxContainer.new()
	info_box.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	info_box.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	name_label = Label.new()
	var p_w_label:= Label.new()
	var i_w_label:= Label.new()
	p_w_label.text = \"Perceived World\"
	i_w_label.text = \"Ideal World\"
	
	p_container = VBoxContainer.new()
	i_container = VBoxContainer.new()
	info_box.add_child(name_label)
	info_box.add_child(HSeparator.new())
	info_box.add_child(p_w_label)
	info_box.add_child(HSeparator.new())
	info_box.add_child(p_container)
	info_box.add_child(HSeparator.new())
	info_box.add_child(i_w_label)
	info_box.add_child(HSeparator.new())
	info_box.add_child(i_container)
	info_box.add_child(HSeparator.new())
	panel_container.add_child(info_box)
	add_child(panel_container)

func _show_character_details(c:Character):
	print(c)
	character = c
	if character == null:
			return
	name_label.text = character.name
	for n in p_container.get_children():
		n.queue_free()
	for i in i_container.get_children():
		i.queue_free()
	for p in character.perceivedWorld.propositions.keys():
		var truth:PW.TriBool = character.getPerceived(p)
		var h_box:= HBoxContainer.new()
		var p_label := Label.new()
		var t_label := Label.new()
		if truth == PW.TriBool.FALSE:
			t_label.add_theme_color_override(\"font_color\",Color.RED)
		elif  truth == PW.TriBool.TRUE:
			t_label.add_theme_color_override(\"font_color\",Color.SEA_GREEN)
		else:
			t_label.add_theme_color_override(\"font_color\",Color.GOLDENROD)
		p_label.text = p
		t_label.text = PW.TriBoolString[truth]
		h_box.add_child(p_label)
		h_box.add_child(VSeparator.new())
		h_box.add_child(t_label)
		p_container.add_child(h_box)
	
	for i in character.idealWorld.propositions.keys():
		var truth:PW.TriBool = character.getIdeal(i)
		var h_box:= HBoxContainer.new()
		var p_label := Label.new()
		var t_label := Label.new()
		if truth == PW.TriBool.FALSE:
			t_label.add_theme_color_override(\"font_color\",Color.RED)
		elif  truth == PW.TriBool.TRUE:
			t_label.add_theme_color_override(\"font_color\",Color.SEA_GREEN)
		else:
			t_label.add_theme_color_override(\"font_color\",Color.GOLDENROD)
		p_label.text = i
		t_label.text = PW.TriBoolString[truth]
		h_box.add_child(p_label)
		h_box.add_child(VSeparator.new())
		h_box.add_child(t_label)
		i_container.add_child(h_box)	
	visible = true

func _hide_character_details(c:Character):
	character = null
	visible = false
"


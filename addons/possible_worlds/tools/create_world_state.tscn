func _ready() -> void:
	proposition_spin_box.max_value = fantasy_propositions.size()
	confirm_button.pressed.connect(_on_confirm_button_pressed)
	
func _on_confirm_button_pressed():
	var path = \"user://%s.tres\" % file_name_line_edit.text.to_snake_case()
	if FileAccess.file_exists(path):
		DirAccess.remove_absolute(path)
	var world_state :WorldState = WorldState.new()
	world_state.take_over_path(path)
	world_state.name = file_name_line_edit.text
	
	if world_state.canonWorld == null:
		world_state.canonWorld = World.new()
	
	var availablePropositions := fantasy_propositions.duplicate()
	for i in range(0,proposition_spin_box.value):
		var proposition:String = availablePropositions.pick_random()
		availablePropositions.erase(proposition)
		world_state.canonWorld.set_truth(proposition,[PW.TriBool.FALSE,PW.TriBool.TRUE].pick_random())
	
	for i in range(0,character_spin_box.value as int):
		var c:= Character.new()

		world_state.characters.append(c)
		var c_name :String = fantasy_first_names.pick_random()
		c_name += \" \"
		c_name += fantasy_last_names.pick_random()
		c.name = c_name
		
		var percProps:Array[StringName]
		# --- Set all perceived props or only some ---
		if(all_knowing_checkbox.button_pressed):
			c.perceivedWorld.match_world(world_state.canonWorld)
			percProps = world_state.canonWorld.propositions.keys()
		else:
			var percPropCount:int = randi_range(1,proposition_spin_box.value as int)
			for p in range(percPropCount):
				percProps.append(world_state.canonWorld.propositions.keys().pick_random())
		# --- Set value for perceived props ---
		if(perfect_reacll_checkbox.button_pressed):
			for k in percProps:
				c.perceivedWorld.set_truth(k,world_state.canonWorld.get_truth(k),randf_range(0,1))
		else:
			for k in percProps:
				c.perceivedWorld.set_truth(k,PW.TriBool.values().pick_random(),randf_range(0,1))
		
		# --- Set ideal world props ---
		for l in percProps:
			c.idealWorld.set_truth(l,PW.TriBool.values().pick_random(),randf_range(0,1))
		
	var error = ResourceSaver.save(world_state,path,ResourceSaver.FLAG_REPLACE_SUBRESOURCE_PATHS)
	if error != OK:
		printerr(error)
	else:
		print(\"World state created\")
	
"

[node name="Control" type="Control"]

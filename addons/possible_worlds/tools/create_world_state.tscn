var fantasy_last_names := [
	\"Stonefist\",
	\"Sunborn\",
	\"Moonspire\",
	\"Dawnsong\",
	\"Blackthorn\",
	\"Ironbane\",
	\"Quicktongue\",
	\"Shadowstep\",
	\"Starcaller\",
	\"Nightbloom\",
	\"Silverleaf\",
	\"Ashveil\",
	\"Bloodhelm\",
	\"Emberglow\",
	\"Swampwalker\",
	\"Greenmark\",
	\"Blackspire\",
	\"Wavecutter\",
	\"Falclaw\",
	\"Of_The_Rose\",
	\"Ravenshollow\",
	\"Of_The_North\",
	\"Frostbane\",
	\"Stormreaver\",
	\"Duskweaver\",
	\"Lightbringer\",
	\"Stoneguard\",
	\"Fireborn\",
	\"Windwalker\",
	\"Nightwind\",
	\"Goldbrook\",
	\"Starcrest\",
	\"Wintermere\",
	\"Hollowvale\",
	\"Brightshore\",
	\"Darkwhisper\",
	\"Oakenshield\",
	\"Ironroot\",
	\"Whitespear\",
	\"Stormwatch\",
	\"Shadowfen\",
	\"Blackvale\",
	\"Emberfall\",

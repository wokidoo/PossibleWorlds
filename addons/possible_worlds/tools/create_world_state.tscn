[gd_scene load_steps=2 format=3 uid="uid://jnnwhyqkgqr1"]

[sub_resource type="GDScript" id="GDScript_hjfav"]
resource_name = "create_world_state_gui"
script/source = "@tool
extends Control

@onready var file_name_line_edit: LineEdit = %FileNameLineEdit
@onready var confirm_button:Button = %ConfirmButton
@onready var proposition_spin_box:SpinBox = %PropositionSpinBox
@onready var character_spin_box: SpinBox=%CharacterSpinBox
@onready var all_knowing_checkbox: CheckBox = %AllKnowingCheckBox
@onready var perfect_reacll_checkbox: CheckBox = %PerfectRecallCheckBox


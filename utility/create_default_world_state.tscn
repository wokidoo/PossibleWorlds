[gd_scene load_steps=2 format=3 uid="uid://6u426iw6t5w2"]

[sub_resource type="GDScript" id="GDScript_67yqs"]
resource_name = "create_default_world_state"
script/source = "extends Node

func _ready() -> void:
	var ok := create_default_world_state()
	if ok:
		print(\"CreateDefaultWorldState: saved default world state to %s\" % WorldServer.DEFAULT_STATE_PATH)
	else:
		push_error(\"CreateDefaultWorldState: failed to save default world state\")

func create_default_world_state() -> bool:
	# Reset for deterministic seeds
	if WorldServer.has_method('_reset_for_tests'):
		WorldServer._reset_for_tests()

	# ── Canonical propositions ───────────────────────────────────────────────
	# Keep the classic three, add one extra for more texture.
	var p_king_dead        := WorldServer.create_proposition(\"The King is dead\",  true)   # canon: true
	var p_world_fair       := WorldServer.create_proposition(\"The world is fair\", false)  # canon: false
	var p_everyone_can_read:= WorldServer.create_proposition(\"Everyone can read\", false)  # canon: false
	var p_dragons_real     := WorldServer.create_proposition(\"Dragons are real\",  true)   # canon: true

	# Convenience ids (now match the proposition descriptions)
	var ID := {
		king_dead         = p_king_dead._prop_id,
		world_fair        = p_world_fair._prop_id,
		everyone_can_read = p_everyone_can_read._prop_id,
		dragons_real      = p_dragons_real._prop_id
	}

	# ── Canonical themes ─────────────────────────────────────────────────────
	WorldServer.register_theme(&\"family\")
	WorldServer.register_theme(&\"religion\")
	WorldServer.register_theme(&\"political\")

	# ── Characters ──────────────────────────────────────────────────────────
	var alice   := Character.new(); alice.name = \"Alice\"
	var bob     := Character.new(); bob.name = \"Bob\"
	var charlie := Character.new(); charlie.name = \"Charlie\"

	WorldServer.add_character(alice)
	WorldServer.add_character(bob)
	WorldServer.add_character(charlie)

	# ── Perceived worlds (mix of matches, contradictions, and omissions) ────
	# Alice:
	# - Denies the king is dead (contradicts), says world is fair (contradicts),
	# - Says not everyone can read (matches), omits dragons.
	alice.believe(ID.king_dead,         false, true) # contradicts
	alice.believe(ID.world_fair,        true,  true) # contradicts
	alice.believe(ID.everyone_can_read, false, true) # matches
	# (no dragons_real belief → omission)

	# Bob:
	# - Accepts king is dead (matches), world is unfair (matches),
	# - Says everyone can read (contradicts), denies dragons (contradicts).
	bob.believe(ID.king_dead,         true,  true) # matches
	bob.believe(ID.world_fair,        false, true) # matches
	bob.believe(ID.everyone_can_read, true,  true) # contradicts
	bob.believe(ID.dragons_real,      false, true) # contradicts

	# Charlie:
	# - Accepts king is dead (matches), says world is fair (contradicts),
	# - Omits literacy and dragons.
	charlie.believe(ID.king_dead,    true,  true) # matches
	charlie.believe(ID.world_fair,   true,  true) # contradicts
	# (no everyone_can_read/dragons_real beliefs → omissions)

	# ── Ideal worlds (distinct per theme & per character) ────────────────────
	# Alice's ideals:
	# family
	alice.set_ideal(&\"family\",   ID.king_dead,         true)
	alice.set_ideal(&\"family\",   ID.world_fair,        false)
	alice.set_ideal(&\"family\",   ID.everyone_can_read, false)
	alice.set_ideal(&\"family\",   ID.dragons_real,      true)

	# religion
	alice.set_ideal(&\"religion\", ID.king_dead,         true)
	alice.set_ideal(&\"religion\", ID.world_fair,        true)
	alice.set_ideal(&\"religion\", ID.everyone_can_read, false)
	alice.set_ideal(&\"religion\", ID.dragons_real,      false)
	
	# political
	alice.set_ideal(&\"political\", ID.king_dead,         true)
	alice.set_ideal(&\"political\", ID.world_fair,        true)
	alice.set_ideal(&\"political\", ID.everyone_can_read, true)
	alice.set_ideal(&\"political\", ID.dragons_real,      true)
	
	# Bob's ideals:
	# family
	bob.set_ideal(&\"family\",     ID.king_dead,         false)
	bob.set_ideal(&\"family\",     ID.world_fair,        false)
	bob.set_ideal(&\"family\",     ID.everyone_can_read, false)
	bob.set_ideal(&\"family\",     ID.dragons_real,      false)

	# political
	bob.set_ideal(&\"political\",  ID.king_dead,         true)
	bob.set_ideal(&\"political\",  ID.world_fair,        false)
	bob.set_ideal(&\"political\",  ID.everyone_can_read, false)
	bob.set_ideal(&\"political\",  ID.dragons_real,      true)

	# Charlie's ideals:
	# religion
	charlie.set_ideal(&\"religion\", ID.king_dead,         true)
	charlie.set_ideal(&\"religion\", ID.world_fair,        true)
	charlie.set_ideal(&\"religion\", ID.everyone_can_read, true)
	charlie.set_ideal(&\"religion\", ID.dragons_real,      false)

	# political
	charlie.set_ideal(&\"political\", ID.king_dead,         true)
	charlie.set_ideal(&\"political\", ID.world_fair,        false)
	charlie.set_ideal(&\"political\", ID.everyone_can_read, false)
	charlie.set_ideal(&\"political\", ID.dragons_real,      true)

	# ── Save ─────────────────────────────────────────────────────────────────
	return WorldServer.save_state()
"

[node name="CreateDefaultWorldState" type="Node"]
script = SubResource("GDScript_67yqs")
